{
  "manifest_version": 3,
  "name": "AI 사용량 수집기",
  "version": "0.4.3",
  "description": "Claude, ChatGPT, Gemini 구독 사용량을 모아 배지와 데스크톱 위젯에 보여 줍니다.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icon.png"
  },
  "action": {
    "default_title": "AI 사용량",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:47823/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/usage*"],
      "js": ["content/gemini-usage.js"],
      "run_at": "document_idle"
    }
  ]
}
